# AWS Phase-D asynchronous render boundary
AWS_REGION=us-east-1
SWARMX_AWS_RENDER_ENABLED=0
SWARMX_AWS_RENDER_BUCKET=
# Inject through AWS/Vercel secret stores; do not commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Phase D may use local FFmpeg until AWS is certified.
SWARMX_PHASE_D_EXECUTION=local
