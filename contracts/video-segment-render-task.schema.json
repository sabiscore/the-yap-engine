{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sabiscore/the-yap-engine/contracts/video-segment-render-task.schema.json",
  "title": "VideoSegmentRenderTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "segmentId", "prompt", "durationSeconds", "fps", "width", "height", "seed", "aspectRatio"],
  "properties": {
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "segmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "negativePrompt": { "type": "string", "maxLength": 4000 },
    "durationSeconds": { "type": "number", "minimum": 1, "maximum": 12 },
    "fps": { "type": "integer", "minimum": 8, "maximum": 30 },
    "width": { "type": "integer", "minimum": 256, "maximum": 1920, "multipleOf": 2 },
    "height": { "type": "integer", "minimum": 256, "maximum": 1920, "multipleOf": 2 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "aspectRatio": { "type": "string", "enum": ["9:16", "1:1", "16:9"] },
    "referenceImagePath": { "type": "string", "maxLength": 2048 },
    "cacheKey": { "type": "string", "maxLength": 128 }
  }
}