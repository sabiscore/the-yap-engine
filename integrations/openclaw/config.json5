// OpenClaw reference configuration for The Yap Engine.
// Keep secrets out of this file. Local Ollama only; SwarmXQ remains the
// production video/model lifecycle authority.
//
// Local agent stack:
//   primary  qwen3:8b                Q4_K_M · ~5.2 GB · coding/reasoning
//   utility  qwen3:4b                Q4_K_M · ~2.6 GB · routing/short tasks
//   vision   qwen3-vl:4b             Q4_K_M · ~3.3 GB · serialized visual QA
//
// OpenClaw may use these models for its bounded coding/research control-plane
// work. It must not call Ollama directly for SwarmX production video stages.

{
  models: {
    providers: {
      ollama: {
        // Native Ollama API. Do not append /v1.
        baseUrl: "http://127.0.0.1:11434",
        api: "ollama",
        apiKey: "ollama-local",
        timeoutSeconds: 300,
        models: [
          {
            id: "qwen3:8b",
            name: "Forge / Qwen3 8B Q4_K_M",
            reasoning: true,
            input: ["text"],
            contextWindow: 40960,
            contextTokens: 6144,
            params: {
              num_ctx: 6144,
              num_predict: 768,
              temperature: 0.2,
              top_p: 0.90,
              keep_alive: "0s",
            },
          },
          {
            id: "qwen3:4b",
            name: "Relay / Qwen3 4B Q4_K_M",
            reasoning: true,
            input: ["text"],
            contextWindow: 40960,
            contextTokens: 4096,
            params: {
              num_ctx: 4096,
              num_predict: 384,
              temperature: 0.1,
              top_p: 0.90,
              keep_alive: "0s",
            },
          },
          {
            id: "qwen3-vl:4b",
            name: "Vision / Qwen3-VL 4B Q4_K_M",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 262144,
            contextTokens: 4096,
            params: {
              num_ctx: 4096,
              num_predict: 384,
              temperature: 0.2,
              top_p: 0.90,
              keep_alive: "0s",
            },
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      model: {
        primary: "ollama/qwen3:8b",
        fallbacks: ["ollama/qwen3:4b"],
      },
      utilityModel: "ollama/qwen3:4b",
      imageModel: {
        primary: "ollama/qwen3-vl:4b",
      },
      timeoutSeconds: 360,
      maxConcurrent: 1,
      modelSelectionScope: "session",
      experimental: {
        // Keeps local-agent prompts/tool catalogs small on constrained hosts.
        localModelLean: true,
      },
      sandbox: {
        // Group/channel sessions are sandboxed; the Gateway/provider remains on-host.
        mode: "non-main",
        backend: "docker",
        scope: "agent",
        workspaceAccess: "rw",
      },
    },
  },

  tools: {
    profile: "coding",
    toolSearch: true,
    deny: [
      "browser",
      "web_search",
      "web_fetch",
      "gateway",
      "cron",
      "nodes",
      "image_generate",
      "music_generate",
      "video_generate",
    ],
    sandbox: {
      tools: {
        deny: ["gateway", "browser", "web_search", "web_fetch", "nodes", "cron"],
      },
    },
  },

  skills: {
    entries: {
      "coding-agent": { enabled: true },
      "swarmx-creative-director": { enabled: true },
      "swarmx-virality-critic": { enabled: true },
      "swarmx-doctor": { enabled: true },
      "swarmx-vision-storyboard": { enabled: true },
      "swarmx-virality-cheatbook": { enabled: true },
    },
  },
}
