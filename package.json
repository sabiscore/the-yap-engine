{
  "name": "swarmxq",
  "version": "2026.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @swarmx/types typecheck && pnpm --filter @swarmx/api build && pnpm --filter @swarmx/dashboard build",
    "lint": "pnpm --filter @swarmx/dashboard lint && ${PYTHON:-.venv/bin/python} -m ruff check .",
    "test": "pnpm --filter @swarmx/dashboard test && pnpm --filter @swarmx/api test",
    "typecheck": "pnpm --filter @swarmx/types typecheck && pnpm --filter @swarmx/api typecheck && pnpm --filter @swarmx/dashboard typecheck",
    "validate:openclaw": "${PYTHON:-python3} scripts/validate-openclaw-integration.py",
    "bench:coding-agent": "${PYTHON:-python3} benchmarks/coding-agent/run.py"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/neon-js": "0.7.0-beta"
  }
}
